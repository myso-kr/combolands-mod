<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The plugin runs inside the game's Mono domain. MelonLoader reports this build as
    "Runtime Type: net35", but it loads a net472 assembly and the game's own Mono is
    6.13 on the 4.x profile - which is what M0 measured, so net472 is what we target.

    GameDir defaults to the Steam path and is overridable:
      dotnet build -c Release -p:GameDir="D:\SteamLibrary\steamapps\common\Combolands"
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CombolandsMod</AssemblyName>
    <RootNamespace>Combolands.Mod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.4.0</Version>
    <Company>myso-kr</Company>
    <Product>Combolands Mod</Product>
    <Description>Korean language patch, cheat widget and autoplay for Combolands.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GameDir)' == ''">
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Combolands</GameDir>
  </PropertyGroup>
  <PropertyGroup>
    <Managed>$(GameDir)\Combolands_Data\Managed</Managed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Every reference is Private=false: these assemblies are already in the process.
    Copying them next to the plugin would put a second copy in Mods/ and MelonLoader
    would load the wrong one.
  -->
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(GameDir)\MelonLoader\net472\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\MelonLoader\net472\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(Managed)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- PointerEventData, so autoplay can click a choice card the way a mouse does. -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(Managed)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(Managed)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(Managed)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>$(Managed)\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreTextEngineModule">
      <HintPath>$(Managed)\UnityEngine.TextCoreTextEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(Managed)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Assembly-CSharp is deliberately NOT referenced. Every game type is reached by
    reflection through Anchors.cs, so a game update that moves one produces a logged
    miss and a dead feature instead of a plugin that will not load at all.
  -->

</Project>
